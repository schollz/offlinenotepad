# PostgreSQL is used whenever DATABASE_URL is present.
DATABASE_URL=postgres://offlinenotepad:change-me@127.0.0.1:5432/offlinenotepad?sslmode=disable

# Without DATABASE_URL, the server uses this CGO-free SQLite database.
SQLITE_PATH=offlinenotepad.sqlite3

PORT=8251
SITE_URL=http://localhost:8251

# Comma-separated extra browser origins, useful when Vite runs on port 5173.
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Optional. Both values must be valid to relay normalized, allowlisted analytics events.
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Keep enabled while users are upgrading staged legacy notebooks. Disable after the migration window.
LEGACY_MIGRATION_ENABLED=true
